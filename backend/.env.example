# Backend environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to Git — it is listed in .gitignore.

# Server
PORT=4000
NODE_ENV=development

# Database — MongoDB Atlas connection string
# Replace <db_password> with your actual Atlas database user password.
MONGODB_URI=mongodb://madhavsaiv789_db_user:<db_password>@ac-dz3fb8p-shard-00-00.ibrwaic.mongodb.net:27017,ac-dz3fb8p-shard-00-01.ibrwaic.mongodb.net:27017,ac-dz3fb8p-shard-00-02.ibrwaic.mongodb.net:27017/?ssl=true&replicaSet=atlas-w7msux-shard-0&authSource=admin&compressors=zlib

# JWT — generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN_SECONDS=28800

# CORS — set this to your frontend URL
CORS_ORIGIN=http://localhost:5173

# Seed user passwords (development only — change before any real deployment)
SEED_ADMIN_PASSWORD=change_me_admin
SEED_OWNER_PASSWORD=change_me_owner
SEED_VIEWER_PASSWORD=change_me_viewer
